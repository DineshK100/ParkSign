Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Alpha: 0.6
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 2
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /scan
      Size (m): 0.08
      Color Transformer: FlatColor
      Color: 255; 85; 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Lot
      Enabled: true
      Topic:
        Value: /signpark/lot_markers
    - Class: rviz_default_plugins/Path
      Name: PlannedPath
      Enabled: true
      Topic:
        Value: /signpark/planned_path
      Color: 0; 200; 255
      Line Style: Billboards
      Line Width: 0.08
    - Class: rviz_default_plugins/Polygon
      Name: CarFootprint
      Enabled: true
      Topic:
        Value: /signpark/footprint
      Color: 255; 255; 0
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/left/image_raw
  Global Options:
    Fixed Frame: map
    Background Color: 40; 40; 45
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 14
      X: 19
      Y: 0
Window Geometry:
  Width: 1400
  Height: 900
