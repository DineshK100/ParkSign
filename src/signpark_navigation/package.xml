<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>signpark_navigation</name>
  <version>0.1.0</version>
  <description>Maneuver mapping, Hybrid-A* planning via Nav2, path tracking and the Park action server.</description>
  <maintainer email="drkarnat@ncsu.edu">Dinesh Karnati</maintainer>
  <maintainer email="pthapa4@ncsu.edu">Pratik Thapa</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>signpark_msgs</exec_depend>
  <exec_depend>signpark_gazebo</exec_depend>
  <exec_depend>signpark_description</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
